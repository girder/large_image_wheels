+#ifndef MAPNIK_GDAL_DATA_GUARD_HPP
+#define MAPNIK_GDAL_DATA_GUARD_HPP
+
+// mapnik
+#include <mapnik/data_paths.hpp>
+
+// gdal
+#include <cpl_conv.h>
+
+// stl
+#include <string>
+
+namespace mapnik {
+namespace gdal_plugin {
+
+// Temporarily point GDAL at mapnik's bundled data directory for the current
+// thread only, restoring the previous thread-local value (if any) on
+// destruction.
+//
+// This deliberately uses the *thread-local* GDAL config option rather than the
+// global one so that other GDAL consumers in the same process (for example a
+// separately imported osgeo.gdal) are not affected, and so that parallel
+// rendering from worker threads stays isolated. Nothing here touches the
+// process environment.
+//
+// When no data directory has been configured via mapnik::set_data_paths() the
+// guard is a no-op and the per-thread value is left untouched, letting GDAL use
+// its own default lookup.
+class gdal_data_guard
+{
+  public:
+    gdal_data_guard()
+        : key_("GDAL_DATA"),
+          had_previous_(false)
+    {
+        std::string const dir = mapnik::gdal_data_dir();
+        if (dir.empty())
+        {
+            active_ = false;
+            return;
+        }
+        active_ = true;
+        char const* previous = CPLGetThreadLocalConfigOption(key_, nullptr);
+        if (previous)
+        {
+            previous_ = previous;
+            had_previous_ = true;
+        }
+        CPLSetThreadLocalConfigOption(key_, dir.c_str());
+    }
+
+    gdal_data_guard(gdal_data_guard const&) = delete;
+    gdal_data_guard& operator=(gdal_data_guard const&) = delete;
+
+    ~gdal_data_guard()
+    {
+        if (!active_)
+        {
+            return;
+        }
+        // nullptr value removes the thread-local option, restoring lookup
+        // to the global/environment default.
+        CPLSetThreadLocalConfigOption(key_, had_previous_ ? previous_.c_str() : nullptr);
+    }
+
+  private:
+    char const* key_;
+    bool active_ = false;
+    bool had_previous_ = false;
+    std::string previous_;
+};
+
+} // namespace gdal_plugin
+} // namespace mapnik
+
+#endif // MAPNIK_GDAL_DATA_GUARD_HPP
