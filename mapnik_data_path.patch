diff --git a/src/data_paths.cpp b/src/data_paths.cpp
new file mode 100644
index 00000000..497d7ce9
--- /dev/null
+++ b/src/data_paths.cpp
@@ -0,0 +1,40 @@
+#include <mapnik/data_paths.hpp>
+
+// stl
+#include <mutex>
+
+namespace mapnik {
+
+namespace {
+
+struct data_paths_t
+{
+    std::string proj_dir;
+    std::string gdal_dir;
+};
+
+std::mutex paths_mutex;
+data_paths_t paths;
+
+} // namespace
+
+void set_data_paths(std::string const& proj_dir, std::string const& gdal_dir)
+{
+    std::lock_guard<std::mutex> lock(paths_mutex);
+    paths.proj_dir = proj_dir;
+    paths.gdal_dir = gdal_dir;
+}
+
+std::string proj_data_dir()
+{
+    std::lock_guard<std::mutex> lock(paths_mutex);
+    return paths.proj_dir;
+}
+
+std::string gdal_data_dir()
+{
+    std::lock_guard<std::mutex> lock(paths_mutex);
+    return paths.gdal_dir;
+}
+
+} // namespace mapnik
