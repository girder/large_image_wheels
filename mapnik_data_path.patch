diff --git a/include/mapnik/data_paths.hpp b/include/mapnik/data_paths.hpp
new file mode 100644
index 00000000..92d78e04
--- /dev/null
+++ b/include/mapnik/data_paths.hpp
@@ -0,0 +1,34 @@
+#ifndef MAPNIK_DATA_PATHS_HPP
+#define MAPNIK_DATA_PATHS_HPP
+
+// mapnik
+#include <mapnik/config.hpp>
+
+// stl
+#include <string>
+
+namespace mapnik {
+
+// Configure the data directories used by the PROJ and GDAL libraries that
+// mapnik links against, without touching the process environment.
+//
+// This is the in-process equivalent of setting the PROJ_DATA/PROJ_LIB and
+// GDAL_DATA environment variables, but it only affects mapnik's own PROJ
+// contexts and mapnik's own GDAL calls. Other consumers of PROJ/GDAL in the
+// same process keep using their own defaults.
+//
+// An empty string means "do not override": the corresponding library falls
+// back to its own default lookup (environment variables, built-in paths).
+//
+// May be called multiple times; later calls replace earlier paths.
+MAPNIK_DECL void set_data_paths(std::string const& proj_dir, std::string const& gdal_dir);
+
+// Directory configured for PROJ data, empty when not overridden.
+MAPNIK_DECL std::string proj_data_dir();
+
+// Directory configured for GDAL data, empty when not overridden.
+MAPNIK_DECL std::string gdal_data_dir();
+
+} // namespace mapnik
+
+#endif // MAPNIK_DATA_PATHS_HPP
