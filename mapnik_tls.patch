+
+#ifndef MAPNIK_UTIL_THREAD_CACHE_HPP
+#define MAPNIK_UTIL_THREAD_CACHE_HPP
+
+// mapnik
+#include <mapnik/config.hpp>
+
+// stl
+#include <cstddef>
+
+namespace mapnik {
+namespace util {
+
+// Every per-thread cache in the process shares a single thread-local slot,
+// defined once in libmapnik (src/thread_cache.cpp) and reached from every
+// shared object through this exported accessor. The slot points at a small
+// per-thread table of type-erased cache pointers, one entry per cache_kind.
+//
+// Why a single slot of pointers instead of `thread_local` cache objects:
+// a `thread_local` object with a non-trivial destructor needs static TLS and
+// registers an exit handler with __cxa_thread_atexit(). A module loaded via
+// dlopen() after worker threads already exist can then fail with "cannot
+// allocate memory in static TLS block", and unloading a module while a thread
+// still holds such an object can leave a dangling exit handler that crashes at
+// thread exit. Pointers have trivial destructors: no exit handler, and the
+// static TLS cost is one word for the whole process no matter how many caches
+// exist.
+//
+// The table itself is created on first use and intentionally leaked when the
+// thread ends: it is small, one per thread, and leaking avoids destructor
+// ordering problems during module unload.
+enum class cache_kind : std::size_t
+{
+    proj_transform = 0,
+    render_pattern,
+    tiles_metadata,
+    tiles_tile,
+    count_
+};
+
+inline constexpr std::size_t cache_kind_count = static_cast<std::size_t>(cache_kind::count_);
+
+namespace detail {
+
+// Address of the current thread's cache table (cache_kind_count pointers).
+// The table itself lives on the heap; the one thread-local slot is a single
+// pointer used to find it. Defined exactly once in libmapnik.
+MAPNIK_DECL void** thread_state_table();
+
+} // namespace detail
+
+// Access the per-thread instance of the cache selected by `kind`.
+//
+// Thread safe: each thread only ever touches its own table, and distinct kinds
+// never collide. The same kind always yields the same instance on a thread.
+template<cache_kind Kind, typename Cache>
+Cache& thread_cache()
+{
+    void** table = detail::thread_state_table();
+    void*& entry = table[static_cast<std::size_t>(Kind)];
+    if (!entry)
+    {
+        entry = new Cache();
+    }
+    return *static_cast<Cache*>(entry);
+}
+
+} // namespace util
+} // namespace mapnik
+
+#endif // MAPNIK_UTIL_THREAD_CACHE_HPP
