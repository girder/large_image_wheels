+#include <mapnik/util/thread_cache.hpp>
+
+namespace mapnik {
+namespace util {
+namespace detail {
+
+// One thread-local slot for the whole process: a single pointer to this
+// thread's cache table.
+//
+// It is a plain pointer with a trivial destructor, so there is no
+// __cxa_thread_atexit() registration and exactly one word of static TLS for the
+// entire process. Every per-thread cache in every mapnik shared object
+// (including dlopen()ed input plugins) is reached through this one slot, so the
+// static TLS footprint does not grow with the number of caches.
+//
+// The table (and the caches it points to) is leaked when the thread ends by
+// design; see thread_cache.hpp for the rationale.
+void** thread_state_table()
+{
+    static thread_local void** table = nullptr;
+    if (!table)
+    {
+        table = new void*[cache_kind_count]();
+    }
+    return table;
+}
+
+} // namespace detail
+} // namespace util
+} // namespace mapnik
