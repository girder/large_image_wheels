diff --git a/packaging/mapnik/__init__.py b/packaging/mapnik/__init__.py
index 1fb21c7ea..5635682d3 100644
--- a/packaging/mapnik/__init__.py
+++ b/packaging/mapnik/__init__.py
@@ -39,6 +39,30 @@ Several things happen when you do:
 import itertools
 import os
 import warnings
+# HDF5 and netCDF (reached through the bundled GDAL) read HDF5_PLUGIN_PATH
+# when they initialize, so it is set before the libraries load.  The
+# bundled filter plugins are appended, so a path the user set is searched
+# first.
+_pluginpath = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hdf5plugin")
+if os.path.isdir(_pluginpath) and _pluginpath not in os.environ.get("HDF5_PLUGIN_PATH", "").split(os.pathsep):
+    os.environ["HDF5_PLUGIN_PATH"] = os.pathsep.join([p for p in (os.environ.get("HDF5_PLUGIN_PATH"), _pluginpath) if p])
+import ctypes.util
+try:
+    ctypes.CDLL(ctypes.util.find_library("stdc++"), mode=ctypes.RTLD_GLOBAL)
+except Exception:
+    pass
+libpath = os.path.abspath(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(
+    __file__))), 'mapnik.libs'))
+if os.path.exists(libpath):
+    libs = os.listdir(libpath)
+    libgdalpath = [lib for lib in libs if lib.startswith('libgdal')][0]
+    ctypes.cdll.LoadLibrary(os.path.join(libpath, libgdalpath))
+
+
+
+localpath = os.path.dirname(os.path.abspath( __file__ ))
+os.environ.setdefault("PROJ_DATA", os.path.join(localpath, "proj"))
+os.environ.setdefault("GDAL_DATA", os.path.join(localpath, "gdal"))
 
